22-July-2026 10:52:45

light 1 off
light 0 rot y  30.0
light 0 rot x -30.0

#
# Plot the cube file mca_orbitals/orbital_02.cube
#

# Load the molecule and change the atom style
mol load cube mca_orbitals/orbital_02.cube
mol modcolor 0 000 Element
mol modstyle 0 000 Licorice 0.110000 10.000000 10.000000

# Define the material for rendering atoms
material change ambient      Opaque 0.310000
material change diffuse      Opaque 0.720000
material change specular     Opaque 0.500000
material change shininess    Opaque 0.480000
material change opacity      Opaque 1.000000
material change outline      Opaque 0.000000
material change outlinewidth Opaque 0.000000
material change transmode    Opaque 0.000000
material change specular     Opaque 0.750000

# Define the material for rendering isosurfaces
material change ambient      EdgyShiny 0.6
material change diffuse      EdgyShiny 0.5
material change mirror       EdgyShiny 0.0
material change opacity      EdgyShiny 1.0
material change outline      EdgyShiny 0.0
material change outlinewidth EdgyShiny 0.0
material change shininess    EdgyShiny 0.75
material change specular     EdgyShiny 0.96
material change transmode    EdgyShiny 0

# Customize atom colors
color Element C silver
color Element H white

# Rotate and translate the molecule
rotate x by 30.0
rotate y by 40.0
rotate z by 15.0
translate by 0.0 0.0 0.0
scale by 1.0

# Eliminate the axis and perfect the view
axes location off
display projection orthographic
display ambientocclusion off
display shadows off
display aoambient 0.5
display aodirect 0.5
display rendermode Tachyon
display depthcue off
display resize 300 300
# Set the background color
color change rgb 1000 1.0 1.0 1.0
color Display Background 1000

color change rgb 0 0.5333333333333333 0.403921568627451 0.6470588235294118

color change rgb 1 0.9254901960784314 0.807843137254902 0.03529411764705882
#
# Add a surface
mol color ColorID 0
mol representation Isosurface 0.02 0 0 0 1 1
mol selection all
mol material EdgyShiny
mol addrep 000
color change rgb 0 0.5333333333333333 0.403921568627451 0.6470588235294118

color change rgb 1 0.9254901960784314 0.807843137254902 0.03529411764705882
#
# Add a surface
mol color ColorID 1
mol representation Isosurface -0.02 0 0 0 1 1
mol selection all
mol material EdgyShiny
mol addrep 000


# Render
render TachyonInternal mca_orbitals/orbital_02.tga
mol delete 000

